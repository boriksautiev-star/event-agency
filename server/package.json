{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restore-db.ps1",
    "db:backups:list": "powershell -NoProfile -Command \"Get-ChildItem ./backups -Filter event_agency_*.dump -ErrorAction SilentlyContinue | Select-Object Name, @{N=SizeMB;E={[math]::Round($_.Length/1MB,2)}}, LastWriteTime | Format-Table -AutoSize\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@event-agency/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
