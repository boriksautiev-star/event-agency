# ===== Окружение =====
NODE_ENV=production
PORT=3100
APP_URL=https://agency.example.com
APP_NAME=Event Agency
TIMEZONE=Europe/Moscow
CURRENCY=RUB
DEFAULT_LOCALE=ru

# ===== PostgreSQL =====
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://event:CHANGE_ME@localhost:5432/event_agency

# ===== JWT =====
# Генерируется автоматически: node -e "console.log(require("crypto").randomBytes(48).toString("hex"))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ===== Первый запуск (setup wizard) =====
# Установочный токен. После создания директора можно удалить эту строку.
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

# ===== Бэкапы =====
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ===== Шифрование (S3 secret keys) =====
# 32 байта в hex. Генерируется: node -e "console.log(require("crypto").randomBytes(32).toString("hex"))"
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
