generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  director
  admin
  animator
}

enum UserStatus {
  active
  blocked
  invited
}

model User {
  id            String     @id @default(uuid())
  role          Role
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String     @unique
  email         String?    @unique
  passwordHash  String     @map("password_hash")
  status        UserStatus @default(active)
  expoPushToken String?    @map("expo_push_token")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  assignments   OrderAnimator[] @relation("AnimatorAssignments")
  orderChanges  OrderChange[]
  rates              Rate[]
  adminCompensations AdminCompensation[] @relation("AdminCompensations")
  adminAccruals      AdminAccrual[]      @relation("AdminAccruals")
  adminPayments      AdminPayment[]      @relation("AdminPayments")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum AdminCompensationType {
  percent
  fixed
}

enum AdminAccrualStatus {
  active
  cancelled
}

model AgencySettings {
  id                       Int      @id @default(1)
  name                     String   @default("Event Agency")
  legalName                String?  @map("legal_name")
  inn                      String?
  phone                    String?
  email                    String?
  address                  String?
  website                  String?
  timezone                 String   @default("Europe/Moscow")
  currency                 String   @default("RUB")
  paymentDetails           String?  @map("payment_details")
  logoUrl                  String?  @map("logo_url")
  defaultPrepaymentPercent Int      @default(30) @map("default_prepayment_percent")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("agency_settings")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([phone])
  @@index([name])
  @@map("clients")
}

model RateGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  characters Character[]
  rates      Rate[]

  @@map("rate_groups")
}

model Character {
  id          String   @id @default(uuid())
  name        String
  rateGroupId String   @map("rate_group_id")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rateGroup    RateGroup              @relation(fields: [rateGroupId], references: [id], onDelete: Restrict)
  priceOptions CharacterPriceOption[]
  slots        OrderSlot[]

  @@index([rateGroupId])
  @@index([name])
  @@map("characters")
}

model CharacterPriceOption {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  durationMin Int      @map("duration_min")
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, durationMin])
  @@index([characterId])
  @@map("character_price_options")
}

model Rate {
  id          String   @id @default(uuid())
  animatorId  String   @map("animator_id")
  rateGroupId String   @map("rate_group_id")
  durationMin Int      @map("duration_min")
  amount      Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  animator  User      @relation(fields: [animatorId], references: [id], onDelete: Cascade)
  rateGroup RateGroup @relation(fields: [rateGroupId], references: [id], onDelete: Cascade)

  @@unique([animatorId, rateGroupId, durationMin])
  @@index([rateGroupId, durationMin])
  @@index([animatorId])
  @@map("rates")
}

enum OrderStatus {
  new
  confirmed
  in_progress
  completed
  cancelled
}

enum AssignmentStatus {
  invited
  accepted
  declined
  removed
  completed
}

enum ReleaseReason {
  declined
  handed_over
  removed_rotation
  removed_quality
  order_cancelled
}

enum TransportPolicy {
  agency_pays
  client_one_way
  client_both_ways
}

enum PaymentMethod {
  transfer
  cash
}

enum PayoutSource {
  rate_matrix
  manual
}

model Order {
  id              String          @id @default(uuid())
  clientId        String          @map("client_id")
  title           String
  description     String?
  eventDate       DateTime        @map("event_date")
  startTime       String          @map("start_time")
  endTime         String          @map("end_time")
  address         String?
  lat             Float?
  lng             Float?
  status          OrderStatus     @default(new)

  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  discountPercent Decimal         @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  clientPrice     Decimal         @default(0) @map("client_price") @db.Decimal(12, 2)

  prepaymentAmount Decimal         @default(0) @map("prepayment_amount") @db.Decimal(12, 2)
  prepaymentPaidAt DateTime?       @map("prepayment_paid_at")

  finalPaymentMethod     PaymentMethod? @map("final_payment_method")
  finalPaymentAmount     Decimal        @default(0) @map("final_payment_amount") @db.Decimal(12, 2)
  finalPaymentReceivedAt DateTime?      @map("final_payment_received_at")
  finalPaymentReceivedBy String?        @map("final_payment_received_by")
  finalPaymentHandedAt   DateTime?      @map("final_payment_handed_at")
  finalPaymentHandedBy   String?        @map("final_payment_handed_by")

  transportPolicy TransportPolicy @default(client_one_way) @map("transport_policy")

  adminId         String?         @map("admin_id")
  comment         String?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  client    Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  animators OrderAnimator[]
  slots     OrderSlot[]
  history   OrderStatusHistory[]
  changes   OrderChange[]
  payments      OrderPayment[]
  expenses      Expense[]
  adminAccruals AdminAccrual[]

  @@index([eventDate])
  @@index([status])
  @@index([clientId])
  @@map("orders")
}

model OrderSlot {
  id                    String   @id @default(uuid())
  orderId               String   @map("order_id")
  characterId           String   @map("character_id")
  rateDurationMinutes   Int      @map("rate_duration_minutes")
  clientPrice           Decimal  @map("client_price") @db.Decimal(12, 2)
  isCustomPrice         Boolean  @default(false) @map("is_custom_price")
  characterNameSnapshot String   @map("character_name_snapshot")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Restrict)
  assignments OrderAnimator[]

  @@index([orderId])
  @@index([characterId])
  @@map("order_slots")
}

model OrderAnimator {
  id            String           @id @default(uuid())
  orderId       String           @map("order_id")
  animatorId    String           @map("animator_id")
  slotId        String?          @map("slot_id")
  payout        Decimal          @default(0) @db.Decimal(12, 2)
  status        AssignmentStatus @default(invited)
  invitedAt     DateTime         @default(now()) @map("invited_at")
  respondedAt   DateTime?        @map("responded_at")
  completedAt   DateTime?        @map("completed_at")

  payoutSource  PayoutSource     @default(manual) @map("payout_source")

  transportCost         Decimal         @default(0) @map("transport_cost") @db.Decimal(12, 2)
  transportPaidBy       TransportPolicy @default(client_one_way) @map("transport_paid_by")
  transportClientAmount Decimal         @default(0) @map("transport_client_amount") @db.Decimal(12, 2)
  transportLockedAt     DateTime?       @map("transport_locked_at")

  payoutPaidAt DateTime?      @map("payout_paid_at")
  payoutPaidBy String?        @map("payout_paid_by")
  payoutMethod PaymentMethod? @map("payout_method")

  releaseReason  ReleaseReason? @map("release_reason")
  releaseComment String?        @map("release_comment")
  releasedAt     DateTime?      @map("released_at")

  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  animator User       @relation("AnimatorAssignments", fields: [animatorId], references: [id], onDelete: Restrict)
  slot     OrderSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@unique([orderId, animatorId])
  @@index([animatorId, status])
  @@index([orderId])
  @@index([slotId])
  @@index([payoutSource, payoutPaidAt])
  @@map("order_animators")
}

model OrderStatusHistory {
  id        String       @id @default(uuid())
  orderId   String       @map("order_id")
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  changedBy String?      @map("changed_by")
  comment   String?
  createdAt DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderChange {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  summary   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_changes")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  orderId     String?  @map("order_id")
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date")
  comment     String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminPayments AdminPayment[]

  @@index([expenseDate])
  @@index([categoryId])
  @@index([orderId])
  @@map("expenses")
}

enum OrderPaymentType {
  prepayment
  final
  refund
}

model OrderPayment {
  id        String           @id @default(uuid())
  orderId   String           @map("order_id")
  type      OrderPaymentType
  amount    Decimal          @db.Decimal(12, 2)
  method    PaymentMethod    @default(transfer)
  paidAt    DateTime         @map("paid_at")
  comment   String?
  createdBy String?          @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paidAt])
  @@map("order_payments")
}

model AdminCompensation {
  id            String                @id @default(uuid())
  adminId       String                @map("admin_id")
  type          AdminCompensationType
  percentValue  Int?                  @map("percent_value")
  fixedAmount   Decimal?              @map("fixed_amount") @db.Decimal(12, 2)
  effectiveFrom DateTime              @map("effective_from")
  createdAt     DateTime              @default(now()) @map("created_at")

  admin User @relation("AdminCompensations", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, effectiveFrom])
  @@map("admin_compensations")
}

model AdminAccrual {
  id           String                @id @default(uuid())
  adminId      String                @map("admin_id")
  orderId      String?               @map("order_id")
  type         AdminCompensationType
  baseAmount   Decimal               @map("base_amount") @db.Decimal(12, 2)
  percentValue Int?                  @map("percent_value")
  amount       Decimal               @db.Decimal(12, 2)
  periodFrom   DateTime?             @map("period_from")
  periodTo     DateTime?             @map("period_to")
  status       AdminAccrualStatus    @default(active)
  comment      String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  admin User   @relation("AdminAccruals", fields: [adminId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([adminId, status])
  @@index([orderId])
  @@map("admin_accruals")
}

model AdminPayment {
  id        String        @id @default(uuid())
  adminId   String        @map("admin_id")
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  paidAt    DateTime      @map("paid_at")
  comment   String?
  expenseId String?       @map("expense_id")
  createdBy String?       @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")

  admin   User     @relation("AdminPayments", fields: [adminId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([adminId, paidAt])
  @@map("admin_payments")
}
